void USART1_IRQHandler(void)
{
	if(U1->SR & USART_SR_RXNE)
	{
		char ch = U1->DR;
		if(i<SIZE-1)
		{
			str[i++] = ch;
			if(ch=='\n')
			{
				str[i] = '\0';
				i=0;
			}
		}
	}
}
