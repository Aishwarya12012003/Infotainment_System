void GPS_Task(void *pvParam) {
	portTickType pxPreviousWakeTime = xTaskGetTickCount();

	while (1) {
//		GPS_Update();
				Get_GNGGA_Data(buff, 100);
				strcpy(buffer, buff);
				if (!strncmp(buffer, "$GNGGA", 6) || !strncmp(buffer, "$GPGGA", 6)) {
					parse_gga(buffer, lat_str, lon_str, time_str);

					// Print immediately using latest date
					UART2_SEND("Time: ");
					UART2_SEND(time_str);
					UART2_SEND("\r\n");
					UART2_SEND("Date: ");
					UART2_SEND(date_str);
					UART2_SEND("\r\n");
					UART2_SEND("Lat : ");
					UART2_SEND(lat_str);
					UART2_SEND("\r\n");
					UART2_SEND("Lon : ");
					UART2_SEND(lon_str);
					UART2_SEND("\r\n\r\n");
				} else if (!strncmp(buffer, "$GNRMC", 6)
						|| !strncmp(buffer, "$GPRMC", 6)) {
					parse_rmc(buffer, date_str);
				}
		vTaskDelayUntil(&pxPreviousWakeTime, 7000 / portTICK_RATE_MS);
	}
	vTaskDelete(NULL);
}



void APDS_Task(void *pvParam) {

	    // Init UART + I2C
		char buf[80];
	    UartPuts("\r\n=== APDS-9900 Gesture-like Demo ===\r\n");

	    // Check chip ID
	    uint8_t id = APDS_Read(ID_REG);
	    sprintf(buf, "Chip ID = 0x%02X\r\n", id);
	    UartPuts(buf);

	    if(id != 0x30) {
	        UartPuts("ERROR: Not APDS-9900. Halting.\r\n");
	        while(1);
	    }

	    // Configure sensor
	    APDS_Write(ATIME_REG, 0xDB);	//ALS TIming regr
	    APDS_Write(PTIME_REG, 0xFF);	//proximity
	    APDS_Write(WTIME_REG, 0xFF);	//wait
	    APDS_Write(CONTROL_REG, 0x2F);
	    APDS_Write(ENABLE_REG, 0x0F);

	    UartPuts("Sensor configured. Calibrating baseline prox...\r\n");

	    // Baseline calibration
	    uint16_t window[WINDOW_SIZE] = {0};
	    int idx = 0;
	    uint32_t sum = 0;
	    for(int i=0; i<16; i++)
	    {
	        sum += APDS_ReadProximity();
	        APDS_DelayMs(10);
	    }
	    uint16_t base_prox = sum / 16;

	    sprintf(buf, "Baseline prox = %u\r\n", base_prox);
	    UartPuts(buf);

	    // Gesture thresholds
	    uint16_t approach_th;
	    uint16_t near_th;
	    uint16_t tap_th;
	    uint16_t fastpass_th;

	     approach_th = (base_prox / 8) + 60;
	     near_th = (base_prox / 2) + 200;
	     tap_th = near_th + 300;
	     fastpass_th = (base_prox / 6) + 80;

	    sprintf(buf, "Thresholds: approach=%u near=%u tap=%u fastpass=%u\r\n",
	            approach_th, near_th, tap_th, fastpass_th);
	    UartPuts(buf);

	    // Init window
	    for(int i=0;i<WINDOW_SIZE;i++) window[i]=base_prox;		//to fill the starting value of baseline

	    gesture_state_t state = GS_IDLE;

	    UartPuts("Starting main loop...\r\n");

	portTickType pxPreviousWakeTime = xTaskGetTickCount();


	while (1) {
		prox = APDS_ReadProximity();
		        window[idx] = prox;
		        idx = (idx + 1) % WINDOW_SIZE;

		        uint32_t s = 0;
		        for(int i=0;i<WINDOW_SIZE;i++) s += window[i];
		        avg = s / WINDOW_SIZE;

		        int32_t delta = (int32_t)avg - (int32_t)base_prox;

		        // Print raw + avg + delta + state
		        sprintf(buf, "PROX raw=%u avg=%u delta=%ld state=%d\r\n",
		                prox, avg, (long)delta, state);
		        UartPuts(buf);

		        APDS_DelayMs(150);

		        // Gesture state machine
		        switch(state)
		        {
		            case GS_IDLE:
		                if(delta > tap_th)
		                {
		                    UartPuts("Gesture: TAP\r\n");
		                    state = GS_WITHDRAW;
		                }

		                else if(delta > near_th)
		                {
		                    UartPuts("Gesture: NEAR\r\n");
		                    state = GS_NEAR;
		                }

		                else if(delta > approach_th)
		                {
		                    UartPuts("Gesture: APPROACH\r\n");
		                    state = GS_APPROACH;
		                }

		                else if(delta > fastpass_th)
		                {
		                    UartPuts("Gesture: FAST PASS\r\n");
		                }
		                break;

		            case GS_APPROACH:
		                if(delta > near_th)
		                    state = GS_NEAR;
		                else if(delta < (int32_t)(approach_th/2))
		                    state = GS_IDLE;
		                break;

		            case GS_NEAR:
		                if(delta < (int32_t)(near_th/2))
		                    state = GS_IDLE;
		                break;

		            case GS_WITHDRAW:
		                if(delta < (int32_t)(approach_th/2))
		                    state = GS_IDLE;
		                break;
		        }
		vTaskDelayUntil(&pxPreviousWakeTime, 5000 / portTICK_RATE_MS);
	}
	vTaskDelete(NULL);
}

